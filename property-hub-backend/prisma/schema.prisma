generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Region {
  id         String     @id @default(uuid())
  code       String     @unique
  name       String
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  leads      Lead[]
  properties Property[]
  managers   User[]     @relation("RegionToUser")

  @@map("regions")
}

model Property {
  id           String         @id @default(uuid())
  name         String
  description  String?
  location     String
  address      String?
  regionId     String
  status       PropertyStatus @default(AVAILABLE)
  price        Decimal        @db.Decimal(15, 2)
  area         Decimal?       @db.Decimal(10, 2)
  bedrooms     Int?
  bathrooms    Int?
  propertyType PropertyType
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  commissions  Commission[]
  leads        Lead[]
  region       Region         @relation(fields: [regionId], references: [id])

  @@index([regionId])
  @@index([status])
  @@map("properties")
}

model Lead {
  id         String     @id @default(uuid())
  name       String
  email      String?
  phone      String
  regionId   String
  propertyId String?
  status     LeadStatus @default(NEW)
  source     String?
  assignedTo String?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  property   Property?  @relation(fields: [propertyId], references: [id])
  region     Region     @relation(fields: [regionId], references: [id])
  visits     Visit[]

  @@index([regionId])
  @@index([status])
  @@index([assignedTo])
  @@map("leads")
}

model Visit {
  id          String      @id @default(uuid())
  leadId      String
  scheduledAt DateTime
  completedAt DateTime?
  status      VisitStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lead        Lead        @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("visits")
}

model Commission {
  id         String           @id @default(uuid())
  amount     Decimal          @db.Decimal(15, 2)
  percentage Decimal?         @db.Decimal(5, 2)
  agentId    String
  propertyId String
  status     CommissionStatus @default(PENDING)
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  property   Property         @relation(fields: [propertyId], references: [id])

  @@index([agentId])
  @@index([propertyId])
  @@index([status])
  @@map("commissions")
}

model UserMetadata {
  id               String   @id @default(uuid())
  keycloakId       String   @unique
  firstName        String?
  lastName         String?
  phone            String?
  regionPreference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([keycloakId])
  @@map("user_metadata")
}

model User {
  id         String   @id @default(uuid())
  keycloakId String?  @unique
  name       String
  email      String   @unique
  phone      String?
  role       String
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  regions    Region[] @relation("RegionToUser")

  @@map("users")
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RESERVED
  UNDER_CONSTRUCTION
}

enum PropertyType {
  APARTMENT
  VILLA
  PLOT
  COMMERCIAL
  INDUSTRIAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISITING
  NEGOTIATING
  CONVERTED
  LOST
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}
