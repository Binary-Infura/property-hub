generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Region {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  active      Boolean    @default(true)
  continent   String?
  country     String?
  state       String?
  city        String?
  tags        String[]
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  locationId  String?
  leads       Lead[]
  properties  Property[]
  location    Location?  @relation(fields: [locationId], references: [id])
  managers    User[]     @relation("RegionToUser")
  campaigns   MarketingCampaign[] @relation("CampaignToRegion")
  adsRequests AdsRequest[]

  @@index([locationId])
  @@map("regions")
}

model Property {
  id            String         @id @default(uuid())
  name          String
  description   String?
  location      String
  address       String?
  videoUrl      String?
  regionId      String?
  status        PropertyStatus @default(AVAILABLE)
  price         Decimal        @db.Decimal(15, 2)
  area          Decimal?       @db.Decimal(10, 2)
  bedrooms      Int?
  bathrooms     Int?
  propertyType  PropertyType
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  onboardedById String?
  category      String?
  city          String?
  locationId    String?
  commissions   Commission[]
  leads         Lead[]
  locationRel   Location?      @relation(fields: [locationId], references: [id])
  onboardedBy   User?          @relation("UserOnboardedProperties", fields: [onboardedById], references: [id])
  region        Region?        @relation(fields: [regionId], references: [id])
  adsRequests   AdsRequest[]

  @@index([regionId])
  @@index([locationId])
  @@index([status])
  @@index([onboardedById])
  @@map("properties")
}

model Lead {
  id         String     @id @default(uuid())
  name       String
  email      String?
  phone      String
  regionId   String
  propertyId String?
  status     LeadStatus @default(NEW)
  source     String?
  assignedTo String?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  campaignId String?
  campaign   MarketingCampaign? @relation(fields: [campaignId], references: [id])
  property   Property?  @relation(fields: [propertyId], references: [id])
  region     Region     @relation(fields: [regionId], references: [id])
  visits     Visit[]

  @@index([regionId])
  @@index([status])
  @@index([assignedTo])
  @@map("leads")
}

model Visit {
  id          String      @id @default(uuid())
  leadId      String
  scheduledAt DateTime
  completedAt DateTime?
  status      VisitStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lead        Lead        @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("visits")
}

model Commission {
  id         String           @id @default(uuid())
  amount     Decimal          @db.Decimal(15, 2)
  percentage Decimal?         @db.Decimal(5, 2)
  agentId    String
  propertyId String
  status     CommissionStatus @default(PENDING)
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  property   Property         @relation(fields: [propertyId], references: [id])

  @@index([agentId])
  @@index([propertyId])
  @@index([status])
  @@map("commissions")
}

model UserMetadata {
  id               String   @id @default(uuid())
  keycloakId       String   @unique
  firstName        String?
  lastName         String?
  phone            String?
  regionPreference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([keycloakId])
  @@map("user_metadata")
}

model User {
  id                  String     @id @default(uuid())
  keycloakId          String?    @unique
  firstName           String
  lastName            String?
  email               String     @unique
  phone               String?
  role                String
  status              String     @default("active")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  agencyName          String?
  metadata            Json?
  rating              Float?
  reraId              String?
  visitsConducted     Int?       @default(0)
  onboardedById       String?
  onboardedProperties Property[] @relation("UserOnboardedProperties")
  onboardedBy         User?      @relation("UserOnboardedUsers", fields: [onboardedById], references: [id])
  onboardedUsers      User[]     @relation("UserOnboardedUsers")
  regions             Region[]   @relation("RegionToUser")
  campaigns           MarketingCampaign[] @relation("CampaignToUser")
  adsRequests         AdsRequest[]

  @@map("users")
}

model CentralAuthorityProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  department  String?
  accessLevel String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("central_authority_profiles")
}

model PropertyPartnerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  companyName    String
  companyAddress String?
  taxId          String?
  licenseNumber  String?
  isPremium      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("property_partner_profiles")
}

model ChannelPartnerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  agencyBusinessName String
  reraNumber         String?
  officeAddress      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("channel_partner_profiles")
}

model Location {
  id         String     @id @default(uuid())
  continent  String
  country    String
  state      String
  city       String
  properties Property[]
  regions    Region[]

  @@unique([continent, country, state, city])
  @@map("locations")
}

model RegionalManagerProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  territory  String?
  kpiTargets Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("regional_manager_profiles")
}

model CommissionManagerProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  paymentAuthorityLimit Decimal? @db.Decimal(15, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("commission_manager_profiles")
}

model MarketingManagerProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  campaignBudgetLimit Decimal? @db.Decimal(15, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("marketing_manager_profiles")
}

model ConsultantProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  specialization  String[]
  experienceYears Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("consultant_profiles")
}

model BuyerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  budgetMin          Decimal? @db.Decimal(15, 2)
  budgetMax          Decimal? @db.Decimal(15, 2)
  preferredLocations String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("buyer_profiles")
}

model ServiceProviderProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  businessName      String
  category          String
  location          String
  availabilityDays  String[]
  availabilityHours String
  rates             String?
  portfolio         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("service_provider_profiles")
}

model ChatSession {
  id                  String            @id @default(uuid())
  mattermostChannelId String            @unique
  channelType         String            @default("DIRECT")
  contextType         String?
  contextId           String?
  status              String            @default("active")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  participants        ChatParticipant[]

  @@index([contextType, contextId])
  @@map("chat_sessions")
}

model ChatParticipant {
  id            String      @id @default(uuid())
  chatSessionId String
  userId        String
  role          String
  joinedAt      DateTime    @default(now())
  lastReadAt    DateTime?
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@unique([chatSessionId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model MattermostUserMapping {
  id                 String   @id @default(uuid())
  propertyHubUserId  String   @unique
  mattermostUserId   String   @unique
  mattermostUsername String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([mattermostUserId])
  @@map("mattermost_user_mappings")
}

enum PropertyStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
  AVAILABLE
  SOLD
  RESERVED
  UNDER_CONSTRUCTION
}

enum PropertyType {
  APARTMENT
  VILLA
  PLOT
  COMMERCIAL
  INDUSTRIAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISITING
  NEGOTIATING
  CONVERTED
  LOST
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model MarketingCampaign {
  id             String    @id @default(uuid())
  name           String
  description    String?
  status         String    @default("DRAFT") // ACTIVE, PAUSED, COMPLETED, DRAFT
  platform       String
  budget         Decimal   @db.Decimal(15, 2)
  spent          Decimal   @default(0) @db.Decimal(15, 2)
  startDate      DateTime
  endDate        DateTime
  targetRegions  Region[]  @relation("CampaignToRegion")
  assignedTo     User[]    @relation("CampaignToUser")
  
  // Performance metrics
  impressions    Int       @default(0)
  clicks         Int       @default(0)
  leadsCount     Int       @default(0)
  conversions    Int       @default(0)
  leads          Lead[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("marketing_campaigns")
}

model AdsRequest {
  id            String   @id @default(uuid())
  title         String
  description   String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  priority      String   @default("MEDIUM")  // LOW, MEDIUM, HIGH
  regionId      String
  propertyId    String?
  requestedById String
  
  region        Region    @relation(fields: [regionId], references: [id])
  property      Property? @relation(fields: [propertyId], references: [id])
  requestedBy   User      @relation(fields: [requestedById], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("ads_requests")
}
