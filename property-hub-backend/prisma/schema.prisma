generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String           @id @default(uuid())
  name                 String
  type                 OrganizationType
  email                String?
  phone                String?
  address              String?
  taxId                String?
  licenseNumber        String?
  logoUrl              String?
  websiteUrl           String?
  isActive             Boolean          @default(true)
  isPremium            Boolean          @default(false)
  subscriptionMode     SubscriptionMode @default(FREE)
  instagramAccessToken String?
  instagramUserId      String?
  instagramUsername    String?
  instagramConnectedAt DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  walletBalance        Decimal          @default(0.00) @db.Decimal(15, 2)
  members              User[]
  walletTransactions   WalletTransaction[] @relation("OrgWalletTransactions")
  paymentOrders        PaymentOrder[]      @relation("OrgPaymentOrders")

  @@index([type])
  @@index([name])
  @@map("organizations")
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  phone             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  reraId            String?
  onboardedById     String?
  firstName         String
  lastName          String?
  isEmailVerified   Boolean             @default(false)
  passwordHash      String?
  resetToken        String?
  avatarUrl         String?
  isPhoneVerified   Boolean             @default(false)
  language          String?             @default("en")
  notifications     Json?               @default("{}")
  onboardingStatus  String?             @default("pending")
  organizationId    String?
  activeRole        UserRole?
  profileData       Json?               @default("{}")
  regionPreference  String?
  resetTokenExpiry  DateTime?
  theme             String?             @default("light")
  status            UserStatus          @default(ACTIVE)
  roles             UserRole[]
  activityLogs      ActivityLog[]
  adsRequests       AdsRequest[]
  callLogs          CallLog[]
  walletTransactions WalletTransaction[] @relation("UserWalletTransactions")
  following         Follow[]            @relation("UserFollowers")
  followers         Follow[]            @relation("UserFollowing")
  authoredNotes     LeadNote[]          @relation("AuthorNotes")
  assignedLeads     Lead[]              @relation("LeadAssignee")
  projectsOnboarded Project[]           @relation("UserOnboardedProjects")
  reels             Reel[]              @relation("UserReels")
  reviews           Review[]            @relation("UserReviews")
  documents         UserDocument[]      @relation("UserDocuments")
  onboardedBy       User?               @relation("UserOnboardedUsers", fields: [onboardedById], references: [id])
  onboardedUsers    User[]              @relation("UserOnboardedUsers")
  organization      Organization?       @relation(fields: [organizationId], references: [id])
  campaignsAssigned MarketingCampaign[] @relation("CampaignToUser")
  assignedProjects  Project[]           @relation("ProjectAssignment")
  invitationsSent   Invitation[]        @relation("UserInvites")
  paymentOrders     PaymentOrder[]      @relation("UserPaymentOrders")
  visitsAsExecutive Visit[]             @relation("VisitExecutiveVisits")

  @@index([email])
  @@index([activeRole])
  @@index([status])
  @@index([organizationId])
  @@index([onboardedById])
  @@index([createdAt])
  @@map("users")
}

model Project {
  id            String        @id @default(uuid())
  name          String
  description   String?
  status        ProjectStatus @default(DRAFT)
  price         Decimal       @db.Decimal(15, 2)
  area          Decimal?      @db.Decimal(10, 2)
  bedrooms      Int?
  bathrooms     Int?
  projectType   ProjectType
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  onboardedById String?
  category      String?

  images         String[]       @default([])
  onboardingStep Int?           @default(1)
  totalTowers    Int?
  totalUnits     Int?
  amenities      String[]       @default(["Parking", "Security", "Lift"])
  highlights     String[]       @default(["Prime Location", "Quality Construction"])
  adsRequests    AdsRequest[]
  commissions    Commission[]
  leads          Lead[]
  loans          Loan[]
  onboardedBy    User?          @relation("UserOnboardedProjects", fields: [onboardedById], references: [id])
  units          PropertyUnit[]
  towers         Tower[]
  reels          Reel[]
  assignedTo     User[]         @relation("ProjectAssignment")

  addressId      String?
  addressRecord  Address?       @relation(fields: [addressId], references: [id])

  @@index([status])
  @@index([onboardedById])
  @@index([projectType])
  @@map("projects")
}

model PropertyUnit {
  id         String     @id @default(uuid())
  projectId  String
  unitNumber String
  floor      Int?
  type       String?
  area       Decimal?   @db.Decimal(10, 2)
  price      Decimal    @db.Decimal(15, 2)
  status     UnitStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  buyerName  String?
  buyerPhone String?
  salePrice  Decimal?   @db.Decimal(15, 2)
  soldAt     DateTime?
  towerId    String?
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tower      Tower?     @relation(fields: [towerId], references: [id], onDelete: Cascade)

  @@unique([projectId, towerId, unitNumber])
  @@index([projectId])
  @@index([towerId])
  @@index([status])
  @@map("property_units")
}

model Tower {
  id          String         @id @default(uuid())
  name        String
  projectId   String
  totalFloors Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units       PropertyUnit[]

  @@index([projectId])
  @@map("towers")
}

model Lead {
  id             String             @id @default(uuid())
  name           String
  email          String?
  phone          String
  status         LeadStatus         @default(NEW)
  source         String?
  assignedTo     String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  campaignId     String?
  projectId      String?
  videoCallRoom  String?
  activityLogs   ActivityLog[]
  callLogs       CallLog[]
  leadNotes      LeadNote[]
  assignedToUser User?              @relation("LeadAssignee", fields: [assignedTo], references: [id])
  campaign       MarketingCampaign? @relation(fields: [campaignId], references: [id])
  project        Project?           @relation(fields: [projectId], references: [id])
  loans          Loan[]
  visits         Visit[]

  @@index([status])
  @@index([assignedTo])
  @@index([projectId])
  @@index([source])
  @@map("leads")
}

model LeadNote {
  id        String           @id @default(uuid())
  leadId    String
  authorId  String
  content   String
  category  LeadNoteCategory @default(GENERAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  author    User             @relation("AuthorNotes", fields: [authorId], references: [id])
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([authorId])
  @@map("lead_notes")
}

model Visit {
  id               String      @id @default(uuid())
  leadId           String
  scheduledAt      DateTime
  completedAt      DateTime?
  status           VisitStatus @default(SCHEDULED)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  visitExecutiveId String?
  lead             Lead        @relation(fields: [leadId], references: [id])
  visitExecutive   User?       @relation("VisitExecutiveVisits", fields: [visitExecutiveId], references: [id])

  @@index([leadId])
  @@index([status])
  @@index([visitExecutiveId])
  @@map("visits")
}

model CallLog {
  id           String    @id @default(uuid())
  sid          String?   @unique
  leadId       String
  consultantId String
  status       String?
  duration     Int?
  recordingUrl String?
  startTime    DateTime  @default(now())
  endTime      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  consultant   User      @relation(fields: [consultantId], references: [id])
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([consultantId])
  @@index([sid])
  @@map("call_logs")
}

model Loan {
  id           String     @id @default(uuid())
  leadId       String
  projectId    String
  bankId       String
  amount       Decimal    @db.Decimal(15, 2)
  tenureYears  Int
  interestRate Decimal    @db.Decimal(5, 2)
  status       LoanStatus @default(PENDING)
  notes        String?
  documents    Json?      @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bank         Bank       @relation(fields: [bankId], references: [id])
  lead         Lead       @relation(fields: [leadId], references: [id])
  project      Project    @relation(fields: [projectId], references: [id])

  @@index([leadId])
  @@index([projectId])
  @@index([bankId])
  @@index([status])
  @@map("loans")
}

model Commission {
  id         String           @id @default(uuid())
  amount     Decimal          @db.Decimal(15, 2)
  percentage Decimal?         @db.Decimal(5, 2)
  agentId    String
  status     CommissionStatus @default(PENDING)
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  projectId  String
  project    Project          @relation(fields: [projectId], references: [id])

  @@index([agentId])
  @@index([projectId])
  @@index([status])
  @@map("commissions")
}

model MarketingCampaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("DRAFT")
  platform    String
  budget      Decimal  @db.Decimal(15, 2)
  spent       Decimal  @default(0) @db.Decimal(15, 2)
  startDate   DateTime
  endDate     DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  leadsCount  Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       Lead[]
  assignedTo  User[]   @relation("CampaignToUser")

  @@index([status])
  @@map("marketing_campaigns")
}

model AdsRequest {
  id            String   @id @default(uuid())
  title         String
  description   String?
  status        String   @default("PENDING")
  priority      String   @default("MEDIUM")
  requestedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  projectId     String?
  budget        Decimal? @db.Decimal(15, 2)
  platform      String?
  project       Project? @relation(fields: [projectId], references: [id])
  requestedBy   User     @relation(fields: [requestedById], references: [id])

  @@index([requestedById])
  @@index([status])
  @@map("ads_requests")
}

model Reel {
  id                              String          @id @default(uuid())
  title                           String?
  description                     String?
  videoUrl                        String
  thumbnailUrl                    String?
  userId                          String
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime        @updatedAt
  projectId                       String
  instagramCaption                String?
  instagramPostUrl                String?
  instagramStatus                 InstagramStatus @default(PENDING)
  officialInstagramModerationNote String?
  publishToOfficialInstagram      Boolean         @default(false)
  publishToPartnerInstagram       Boolean         @default(false)
  project                         Project         @relation(fields: [projectId], references: [id])
  user                            User            @relation("UserReels", fields: [userId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@map("reels")
}

model Review {
  id             String   @id @default(uuid())
  content        String
  rating         Int
  authorId       String
  authorName     String
  authorRole     String
  isApproved     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  authorIcon     String?
  showOnHomepage Boolean  @default(false)
  author         User     @relation("UserReviews", fields: [authorId], references: [id])

  @@index([isApproved])
  @@map("reviews")
}

model UserDocument {
  id        String   @id @default(uuid())
  userId    String
  name      String
  category  String
  url       String
  status    String   @default("uploaded")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("user_documents")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  action    String
  target    String
  timestamp DateTime @default(now())
  details   Json?
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId])
  @@index([type])
  @@map("activity_logs")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id])
  following   User     @relation("UserFollowing", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model ChatSession {
  id           String            @id @default(uuid())
  channelType  String            @default("DIRECT")
  contextType  String?
  contextId    String?
  status       String            @default("active")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants ChatParticipant[]

  @@index([contextType, contextId])
  @@map("chat_sessions")
}

model ChatParticipant {
  id            String      @id @default(uuid())
  chatSessionId String
  userId        String
  role          String
  joinedAt      DateTime    @default(now())
  lastReadAt    DateTime?
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@unique([chatSessionId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model City {
  id        String    @id @default(uuid())
  geoId     Int?      @unique
  name      String
  state     String
  latitude  Float?
  longitude Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  active    Boolean   @default(true)
  addresses Address[]

  @@index([name])
  @@map("cities")
}

model PostalCode {
  id           String    @id @default(uuid())
  code         String
  circleName   String?
  regionName   String?
  divisionName String?
  officeName   String?
  officeType   String?
  delivery     String?
  district     String?
  stateName    String?
  latitude     String?
  longitude    String?
  city         String?
  state        String?
  country      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  continent    String?

  @@unique([code, officeName])
  @@index([code])
  @@index([district])
  @@map("postal_codes")
}

model Bank {
  id         String   @id @default(uuid())
  name       String   @unique
  percentage Decimal  @db.Decimal(5, 2)
  logoUrl    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  loans      Loan[]

  @@map("banks")
}

model ReraProject {
  id               String    @id @default(uuid())
  state            String
  reraNumber       String    @unique
  projectName      String
  promoterName     String
  status           String?
  district         String?
  address          String?
  registrationDate DateTime?
  completionDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("rera_projects")
}

model ReraSyncLog {
  id              String    @id @default(uuid())
  state           String
  district        String?
  status          String
  projectsScraped Int       @default(0)
  error           String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@map("rera_sync_logs")
}

model ReraDistrictCount {
  id           String   @id @default(uuid())
  state        String
  district     String
  projectCount Int
  updatedAt    DateTime @updatedAt

  @@unique([state, district])
  @@map("rera_district_counts")
}

model PostalCodeSyncLog {
  id              String    @id @default(uuid())
  status          String
  recordsImported Int       @default(0)
  totalRecords    Int       @default(0)
  lastOffset      Int       @default(0)
  error           String?
  startedById     String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@map("postal_code_sync_logs")
}

model WebhookLog {
  id              String   @id @default(uuid())
  method          String
  endpoint        String
  idempotencyKey  String?  @unique
  requestPayload  Json
  responseStatus  Int
  responseBody    Json?
  executionTimeMs Int
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([idempotencyKey])
  @@index([endpoint])
  @@index([createdAt])
  @@map("webhook_logs")
}

model Invitation {
  id          String           @id @default(uuid())
  email       String?
  phone       String?
  roles       UserRole[]
  token       String           @unique
  type        InvitationType   @default(PLATFORM)
  status      InvitationStatus @default(PENDING)
  invitedById String
  invitedBy   User             @relation("UserInvites", fields: [invitedById], references: [id])
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([token])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("invitations")
}

enum InvitationType {
  PLATFORM
  THIRD_PARTY
}

model PaymentOrder {
  id                String   @id @default(uuid())
  userId            String
  organizationId    String?
  amount            Decimal  @db.Decimal(15, 2)
  currency          String   @default("INR")
  status            String   @default("PENDING") // PENDING, SUCCESS, FAILED
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  razorpaySignature String?
  receipt           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation("UserPaymentOrders", fields: [userId], references: [id])
  organization      Organization? @relation("OrgPaymentOrders", fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("payment_orders")
}

enum UserRole {
  CENTRAL_AUTHORITY
  PROPERTY_PARTNER
  BROKER
  BUYER
  CONSULTANT
  GROWTH_PARTNER
  LOAN_ADVISOR
  VISIT_EXECUTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ConsultantType {
  PLATFORM
  PROPERTY_PARTNER
}

enum OrganizationType {
  PLATFORM
  PROPERTY_PARTNER
  GROWTH_PARTNER
}

enum ProjectStatus {
  DRAFT
  UNDER_CONSTRUCTION
  SUBMITTED
  APPROVED
  REJECTED
}

enum InstagramStatus {
  PENDING
  PUBLISHED
  FAILED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ProjectType {
  APARTMENT
  VILLA
  PLOT
  COMMERCIAL
  INDUSTRIAL
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISITING
  NEGOTIATING
  CONVERTED
  LOST
  FOLLOW_UP_STARTED
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum LoanStatus {
  PENDING
  PROCESSING
  APPROVED
  DISBURSED
  REJECTED
}

enum LeadNoteCategory {
  GENERAL
  PREFERENCE
  BUDGET
  LEGAL
  FOLLOW_UP
}

enum SubscriptionMode {
  PAID
  FREE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Address {
  id            String   @id @default(uuid())
  line1         String
  line2         String?
  pincode       String?
  latitude      Float?
  longitude     Float?
  googlePlaceId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cityId        String
  city          City     @relation(fields: [cityId], references: [id])

  projects      Project[]

  @@index([cityId])
  @@index([cityId, pincode])
  @@map("addresses")
}


model WalletTransaction {
  id              String   @id @default(uuid())
  userId          String?
  organizationId  String?
  amount          Decimal  @db.Decimal(15, 2)
  type            String   // RECHARGE, CALL_COST, OTHER
  status          String   @default("COMPLETED") // COMPLETED, PENDING, FAILED
  referenceId     String?  // PaymentOrder ID or Call ID
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation("UserWalletTransactions", fields: [userId], references: [id])
  organization    Organization? @relation("OrgWalletTransactions", fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("wallet_transactions")
}
