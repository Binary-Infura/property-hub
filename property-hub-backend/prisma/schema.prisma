generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String         @id @default(uuid())
  name          String
  description   String?
  location      String
  address       String?
  status        ProjectStatus @default(AVAILABLE)
  price         Decimal       @db.Decimal(15, 2)
  area          Decimal?      @db.Decimal(10, 2)
  bedrooms      Int?
  bathrooms     Int?
  projectType   ProjectType
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  onboardedById String?
  category      String?
  cityId        String?
  videoUrl      String?
  postalCodeId  String?
  adsRequests   AdsRequest[]
  commissions   Commission[]
  leads         Lead[]
  units         PropertyUnit[]
  assignedTo    User[]         @relation("ProjectAssignment")
  city          City?          @relation(fields: [cityId], references: [id])
  onboardedBy   User?          @relation("UserOnboardedProjects", fields: [onboardedById], references: [id])
  postalCode    PostalCode?    @relation("ProjectPostalCode", fields: [postalCodeId], references: [id])

  @@index([postalCodeId])
  @@index([status])
  @@index([onboardedById])
  @@map("projects")
}

model PropertyUnit {
  id          String     @id @default(uuid())
  projectId   String
  unitNumber  String
  floor       Int?
  type        String?    // e.g. "2BHK", "3BHK", "Studio"
  area        Decimal?   @db.Decimal(10, 2)
  price       Decimal    @db.Decimal(15, 2)
  status      UnitStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  buyerName   String?
  buyerPhone  String?
  salePrice   Decimal?   @db.Decimal(15, 2)
  soldAt      DateTime?

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, unitNumber])
  @@index([projectId])
  @@index([status])
  @@map("property_units")
}

model Lead {
  id             String             @id @default(uuid())
  name           String
  email          String?
  phone          String
  projectId      String?
  status         LeadStatus         @default(NEW)
  source         String?
  assignedTo     String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  campaignId     String?
  assignedToUser User?              @relation("LeadAssignee", fields: [assignedTo], references: [id])
  campaign       MarketingCampaign? @relation(fields: [campaignId], references: [id])
  project        Project?           @relation(fields: [projectId], references: [id])
  visits         Visit[]

  @@index([status])
  @@index([assignedTo])
  @@map("leads")
}

model Visit {
  id          String      @id @default(uuid())
  leadId      String
  scheduledAt DateTime
  completedAt DateTime?
  status      VisitStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lead        Lead        @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("visits")
}

model Commission {
  id        String           @id @default(uuid())
  amount    Decimal          @db.Decimal(15, 2)
  percentage Decimal?         @db.Decimal(5, 2)
  agentId   String
  projectId String
  status    CommissionStatus @default(PENDING)
  paidAt    DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  project   Project          @relation(fields: [projectId], references: [id])

  @@index([agentId])
  @@index([projectId])
  @@index([status])
  @@map("commissions")
}

model UserMetadata {
  id               String   @id @default(uuid())
  userId           String   @unique
  firstName        String?
  lastName         String?
  phone            String?
  regionPreference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  language         String?  @default("en")
  notifications    Json?    @default("{}")
  onboardingStatus String?  @default("pending")
  theme            String?  @default("light")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_metadata")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  phone                    String?
  roles                    String[]
  defaultRole              String?
  status                   String                    @default("active")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  agencyName               String?
  rating                   Float?
  reraId                   String?
  visitsConducted          Int?                      @default(0)
  onboardedById            String?
  firstName                String
  lastName                 String?
  isEmailVerified          Boolean                   @default(false)
  passwordHash             String?
  resetToken               String?
  adsRequests              AdsRequest[]
  buyerProfile             BuyerProfile?
  centralAuthorityProfile  CentralAuthorityProfile?
  consultantProfile        ConsultantProfile?
  brokerProfile           BrokerProfile?
  influencerProfile        InfluencerProfile?
  leads                    Lead[]                    @relation("LeadAssignee")
  marketingManagerProfile  MarketingManagerProfile?
  projectsOnboarded        Project[]                 @relation("UserOnboardedProjects")
  propertyPartnerProfile   PropertyPartnerProfile?
  serviceProviderProfile   ServiceProviderProfile?
  userMetadata             UserMetadata?
  onboardedBy              User?                     @relation("UserOnboardedUsers", fields: [onboardedById], references: [id])
  onboardedUsers           User[]                    @relation("UserOnboardedUsers")
  campaignsAssigned        MarketingCampaign[]       @relation("CampaignToUser")
  assignedProjects         Project[]                 @relation("ProjectAssignment")
  activityLogs             ActivityLog[]
  @@map("users")
}

model InfluencerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  socialMediaLinks Json?
  reach            Int?
  niche            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@map("influencer_profiles")
}

model CentralAuthorityProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  department  String?
  accessLevel String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@map("central_authority_profiles")
}

model PropertyPartnerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  companyName    String
  companyAddress String?
  taxId          String?
  licenseNumber  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isPremium      Boolean  @default(false)
  subscriptionMode SubscriptionMode @default(PAID)
  user           User             @relation(fields: [userId], references: [id])

  @@map("property_partner_profiles")
}

model BrokerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  agencyBusinessName String
  reraNumber         String?
  officeAddress      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])

  @@map("broker_profiles")
}




model MarketingManagerProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  campaignBudgetLimit Decimal? @db.Decimal(15, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id])

  @@map("marketing_manager_profiles")
}

model ConsultantProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  specialization  String[]
  experienceYears Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@map("consultant_profiles")
}

model BuyerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  budgetMin          Decimal? @db.Decimal(15, 2)
  budgetMax          Decimal? @db.Decimal(15, 2)
  preferredLocations String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])

  @@map("buyer_profiles")
}

model ServiceProviderProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  businessName      String
  category          String
  location          String
  availabilityDays  String[]
  availabilityHours String
  rates             String?
  portfolio         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@map("service_provider_profiles")
}

model ChatSession {
  id                  String            @id @default(uuid())
  mattermostChannelId String            @unique
  channelType         String            @default("DIRECT")
  contextType         String?
  contextId           String?
  status              String            @default("active")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  participants        ChatParticipant[]

  @@index([contextType, contextId])
  @@map("chat_sessions")
}

model ChatParticipant {
  id            String      @id @default(uuid())
  chatSessionId String
  userId        String
  role          String
  joinedAt      DateTime    @default(now())
  lastReadAt    DateTime?
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@unique([chatSessionId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model MattermostUserMapping {
  id                 String   @id @default(uuid())
  propertyHubUserId  String   @unique
  mattermostUserId   String   @unique
  mattermostUsername String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([mattermostUserId])
  @@map("mattermost_user_mappings")
}

model MarketingCampaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("DRAFT")
  platform    String
  budget      Decimal  @db.Decimal(15, 2)
  spent       Decimal  @default(0) @db.Decimal(15, 2)
  startDate   DateTime
  endDate     DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  leadsCount  Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       Lead[]
  assignedTo  User[]   @relation("CampaignToUser")

  @@map("marketing_campaigns")
}

model AdsRequest {
  id            String   @id @default(uuid())
  title         String
  description   String?
  status        String   @default("PENDING")
  priority      String   @default("MEDIUM")
  projectId     String?
  requestedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project? @relation(fields: [projectId], references: [id])
  requestedBy   User     @relation(fields: [requestedById], references: [id])

  @@map("ads_requests")
}

model WebhookLog {
  id              String   @id @default(uuid())
  method          String
  endpoint        String
  idempotencyKey  String?  @unique
  requestPayload  Json
  responseStatus  Int
  responseBody    Json?
  executionTimeMs Int
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([idempotencyKey])
  @@index([endpoint])
  @@index([createdAt])
  @@map("webhook_logs")
}

model PostalCode {
  id           String     @id @default(uuid())
  code         String
  circleName   String?
  regionName   String?
  divisionName String?
  officeName   String?
  officeType   String?
  delivery     String?
  district     String?
  stateName    String?
  latitude     String?
  longitude    String?
  city         String?
  state        String?
  country      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  continent    String?
  projects     Project[]  @relation("ProjectPostalCode")

  @@index([code])
  @@index([district])
  @@unique([code, officeName])
  @@map("postal_codes")
}

model ReraProject {
  id               String    @id @default(uuid())
  state            String
  reraNumber       String    @unique
  projectName      String
  promoterName     String
  status           String?
  district         String?
  address          String?
  registrationDate DateTime?
  completionDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("rera_projects")
}

model ReraSyncLog {
  id              String    @id @default(uuid())
  state           String
  district        String?
  status          String
  projectsScraped Int       @default(0)
  error           String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@map("rera_sync_logs")
}

model PostalCodeSyncLog {
  id              String    @id @default(uuid())
  status          String    // 'IN_PROGRESS', 'COMPLETED', 'FAILED'
  recordsImported Int       @default(0)
  totalRecords    Int       @default(0)
  lastOffset      Int       @default(0)
  error           String?
  startedById     String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@map("postal_code_sync_logs")
}

enum ProjectStatus {
  AVAILABLE
  SOLD
  RESERVED
  UNDER_CONSTRUCTION
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum ProjectType {
  APARTMENT
  VILLA
  PLOT
  COMMERCIAL
  INDUSTRIAL
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISITING
  NEGOTIATING
  CONVERTED
  LOST
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model City {
  id          String   @id @default(uuid())
  name        String   @unique
  state       String
  active      Boolean  @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  projects    Project[]

  @@map("cities")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  type      String   // 'info', 'alert', 'warning'
  action    String   // e.g., 'Property Created', 'User Registered'
  target    String   // e.g., 'Luxury Villa', 'Broker John'
  timestamp DateTime @default(now())
  details   Json?

  user      User?    @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId])
  @@map("activity_logs")
}


enum SubscriptionMode {
  PAID
  FREE
}
