{
    "id": "property-hub",
    "realm": "property-hub",
    "displayName": "Property Hub",
    "enabled": true,
    "sslRequired": "external",
    "registrationAllowed": false,
    "loginWithEmailAllowed": true,
    "roles": {
        "realm": [
            {
                "name": "buyer",
                "description": "End user / Property buyer"
            },
            {
                "name": "central-authority",
                "description": "Platform-wide administrator"
            },
            {
                "name": "regional-manager",
                "description": "Manager for a specific region"
            },
            {
                "name": "property-partner",
                "description": "Property developer and partner"
            },
            {
                "name": "consultant",
                "description": "Property consultant"
            },
            {
                "name": "channel-partner",
                "description": "External partner"
            },
            {
                "name": "commission-manager",
                "description": "Manages commissions"
            },
            {
                "name": "marketing-manager",
                "description": "Head of marketing department"
            },
            {
                "name": "onboarding-manager",
                "description": "Manages property onboarding"
            },
            {
                "name": "loan-adviser",
                "description": "Advises on loans"
            },
            {
                "name": "visit-executive",
                "description": "Manages property visits"
            }
        ]
    },
    "clients": [
        {
            "clientId": "property-hub-frontend",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": true,
            "directAccessGrantsEnabled": true,
            "webOrigins": [
                "*"
            ],
            "redirectUris": [
                "*"
            ],
            "defaultClientScopes": [
                "web-origins",
                "role_list",
                "roles",
                "profile",
                "email",
                "openid"
            ],
            "protocolMappers": [
                {
                    "name": "groups-mapper",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-group-membership-mapper",
                    "consentRequired": false,
                    "config": {
                        "full.path": "true",
                        "id.token.claim": "true",
                        "access.token.claim": "true",
                        "claim.name": "groups",
                        "userinfo.token.claim": "true"
                    }
                }
            ]
        }
    ],
    "users": []
}