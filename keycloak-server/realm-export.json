{
    "id": "property-hub",
    "realm": "property-hub",
    "displayName": "Property Hub",
    "enabled": true,
    "sslRequired": "external",
    "registrationAllowed": false,
    "loginWithEmailAllowed": true,
    "roles": {
        "realm": [
            {
                "name": "buyer",
                "description": "End user / Property buyer"
            },
            {
                "name": "internal",
                "description": "Internal staff member with region-specific roles"
            }
        ]
    },
    "clients": [
        {
            "clientId": "property-hub-frontend",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": true,
            "directAccessGrantsEnabled": true,
            "webOrigins": [
                "*"
            ],
            "redirectUris": [
                "*"
            ],
            "defaultClientScopes": [
                "web-origins",
                "role_list",
                "roles",
                "profile",
                "email",
                "openid"
            ],
            "protocolMappers": [
                {
                    "name": "regions-mapper",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-attribute-mapper",
                    "consentRequired": false,
                    "config": {
                        "userinfo.token.claim": "true",
                        "user.attribute": "regions",
                        "id.token.claim": "true",
                        "access.token.claim": "true",
                        "claim.name": "regions",
                        "jsonType.label": "JSON"
                    }
                }
            ]
        }
    ],
    "users": []
}